# =============================================================================
# .dockerignore for idtx-core
# -----------------------------------------------------------------------------
# Goal: keep the Docker build context small AND prevent host-side state from
# leaking into the container image. Leaked state (partial vcpkg buildtrees,
# stale cache markers, developer overrides) is a common cause of non-
# deterministic / "random" vcpkg build failures inside `docker build`.
# =============================================================================


# -----------------------------------------------------------------------------
# Third-party working directories (built INSIDE the container)
# -----------------------------------------------------------------------------
# Everything under thirdparty/ is either downloaded, cloned or generated by
# the in-container SCons build (vcpkg checkout, vcpkg_installed/, USD build,
# .vcpkg_installed_hash marker, buildtrees, packages, downloads, ...).
# Copying any of it from the host risks:
#   * partial/aborted vcpkg state being reused
#   * host-triplet artifacts (e.g. arm64-osx) confusing the linux build
#   * the cache-hash marker file causing `_install_deps` to skip installation
thirdparty/

# Defensive extras (in case someone relocates vcpkg out of thirdparty/)
**/vcpkg_installed/
**/vcpkg/buildtrees/
**/vcpkg/packages/
**/vcpkg/downloads/
**/.vcpkg_installed_hash
**/vcpkg-archives/
**/.vcpkg-cache/


# -----------------------------------------------------------------------------
# Build outputs (regenerated in the container)
# -----------------------------------------------------------------------------
build/
**/build/
bin/
!bin/uploads
shared/build/
**/.scons_cache/
**/.sconsign.dblite


# -----------------------------------------------------------------------------
# Developer overrides
# -----------------------------------------------------------------------------
# SConstruct optionally imports `custom.py` to override paths/versions.
# It must NEVER end up in a reproducible container image.
custom.py
scons/custom.py


# -----------------------------------------------------------------------------
# Dockerfile itself
# -----------------------------------------------------------------------------
# Changes to the Dockerfile should not invalidate the source-copy layer cache.
Dockerfile
Dockerfile.*
.dockerignore


# -----------------------------------------------------------------------------
# Version control
# -----------------------------------------------------------------------------
.git/
.gitignore
.gitattributes
.github/
.gitmodules


# -----------------------------------------------------------------------------
# IDE / editor files
# -----------------------------------------------------------------------------
.vs/
.vscode/
.idea/
**/*.suo
**/*.user
**/*.userosscache
**/*.sln.docstates
**/*.swp
**/*.swo
*~
.DS_Store


# -----------------------------------------------------------------------------
# Compiled / binary artifacts (must be rebuilt in-container)
# -----------------------------------------------------------------------------
**/*.obj
**/*.o
**/*.exe
**/*.dll
**/*.so
**/*.so.*
**/*.dylib
**/*.a
**/*.lib
**/*.pdb
**/*.ilk
**/*.exp


# -----------------------------------------------------------------------------
# Documentation (not needed at build/runtime)
# -----------------------------------------------------------------------------
*.md
# Uncomment if any tool at build time expects README.md / CONTRIBUTING.md:
#!README.md
#!**/README.md


# -----------------------------------------------------------------------------
# Tests
# -----------------------------------------------------------------------------
test/
tests/
*.test


# -----------------------------------------------------------------------------
# Logs / temp / misc
# -----------------------------------------------------------------------------
*.log
tmp/
temp/
*.tmp
Thumbs.db
ehthumbs.db


# -----------------------------------------------------------------------------
# Python caches
# -----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
dist/


# -----------------------------------------------------------------------------
# Archives (should never be committed / copied)
# -----------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z


# -----------------------------------------------------------------------------
# Secrets / local environment (must never enter the image)
# -----------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
!**/LICENSES/**/*.txt