# ignore editor configurations
/.vscode
/.idea
/.venv
.DS_Store

# ignore binary files that will be generated by the build process
*.dll
*.so
*.dylib
*.exp
*.lib
*.pdb
*.obj
*.os
*.o
*.a

# ignore files and folders generated during build process
/thirdparty
/shared/build
.sconsign.dblite
/build
__pycache__/
**/__pycache__/
*.py[cod]

# ignore local scons build customization file
custom.py

# keep the version config file within the build/app folder and ignore all other files in those structure
!/bin
/bin/*
!/bin/version.cfg